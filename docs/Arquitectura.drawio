                <!-- ===================== Notas ===================== -->
                <mxCell id="note_pins" parent="box" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;spacing=8;" value="&lt;b&gt;Pines tentativos del F405 (validar en STM32CubeMX)&lt;/b&gt;&lt;br&gt;• SPI1 (IMU): PA4 CS · PA5 SCK · PA6 MISO · PA7 MOSI · INT1 → PC4 (EXTI4)&lt;br&gt;• I2C1 (barómetro): PB8 SCL · PB9 SDA · INT → PC5 (EXTI5)&lt;br&gt;• ADC: PB0 VBAT_SENSE · PB1 CURR_SENSE&lt;br&gt;• SDIO: PC8–PC12, PD2 → &lt;b&gt;MTR3/MTR4 deben salir de PC8/PC9&lt;/b&gt; (p. ej. TIM2 en PA2/PA3)&lt;br&gt;• USB FS: PA11/PA12 · SWD: PA13/PA14 · UART1 debug: PA9/PA10" vertex="1">
                    <mxGeometry height="130" width="720" x="20" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="note_removed" parent="box" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;spacing=8;" value="&lt;b&gt;Eliminados respecto al esquemático anterior&lt;/b&gt;&lt;br&gt;• ATmega328P, nRF24L01 y LM358 (hojas STM32G0B1 / Receptor): reemplazados por receptor ELRS por UART.&lt;br&gt;• OLED fijo en placa: reemplazado por el conector de expansión.&lt;br&gt;• Bus I2C compartido OLED + barómetro: el barómetro va en I2C propio." vertex="1">
                    <mxGeometry height="130" width="740" x="760" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="box" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=8;" value="&lt;b&gt;Leyenda:&lt;/b&gt; &lt;span style=&quot;background-color:#d5e8d4&quot;&gt;&amp;nbsp;MCU principal&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#ffe6cc&quot;&gt;&amp;nbsp;MCU secundario&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#f8cecc&quot;&gt;&amp;nbsp;Sensores&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#fff2cc&quot;&gt;&amp;nbsp;Almacenamiento / radio&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#e1d5e7&quot;&gt;&amp;nbsp;Conectores / interfaz&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#f5f5f5&quot;&gt;&amp;nbsp;Energía&amp;nbsp;&lt;/span&gt; · Línea discontinua roja: señales analógicas · Flecha doble: bidireccional" vertex="1">
